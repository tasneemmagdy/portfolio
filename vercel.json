{
  "buildCommand": "bash install_flutter.sh && flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "installCommand": "echo 'skip'",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}